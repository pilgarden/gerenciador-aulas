# Copie para .env local (não commitar)
FLASK_APP=run:app
FLASK_CONFIG=development
SECRET_KEY=altere-em-desenvolvimento

# Produção (Render) — configurar no painel do Render, não neste arquivo:
# FLASK_CONFIG=production
# DATABASE_URL=postgresql://usuario:senha@host/db?sslmode=require
# SECRET_KEY=<gerada com: python -c "import secrets; print(secrets.token_hex(32))">
